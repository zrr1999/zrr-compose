# Copy to /etc/komodo/restic.env, replace values, and chmod 0600.
# The repository must be independent from the workload-host Restic repository.
RESTIC_REPOSITORY=s3:https://REPLACE_ON_HOST.r2.cloudflarestorage.com/komodo-core
RESTIC_PASSWORD=REPLACE_ON_HOST
AWS_ACCESS_KEY_ID=REPLACE_ON_HOST
AWS_SECRET_ACCESS_KEY=REPLACE_ON_HOST
