# Copy to /etc/komodo/core.env, replace every REPLACE_ON_HOST value, and chmod 0600.
# Keep this file in simple KEY=value form without shell expansions or quoted secrets.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=REPLACE_ON_HOST
KOMODO_DATABASE_DB_NAME=komodo

TZ=Asia/Shanghai
KOMODO_HOST=https://komodo.zrr.dev
KOMODO_TITLE=Home Komodo
KOMODO_CORS_ALLOWED_ORIGINS=https://komodo.zrr.dev

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=REPLACE_ON_HOST
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=true
KOMODO_TRANSPARENT_MODE=false

# Set this to false only during the one-time bootstrap Resource Sync creation.
KOMODO_UI_WRITE_DISABLED=true
# The default auto-update Procedure is intentionally omitted; Git merge is the only update path.
KOMODO_DISABLE_INIT_RESOURCES=true
KOMODO_DISABLE_CONFIRM_DIALOG=false

KOMODO_WEBHOOK_SECRET=REPLACE_ON_HOST
KOMODO_JWT_SECRET=REPLACE_ON_HOST
KOMODO_JWT_TTL=1-day
KOMODO_CLI_MAX_BACKUPS=14
KOMODO_MONITORING_INTERVAL=15-sec
KOMODO_RESOURCE_POLL_INTERVAL=1-hr
KOMODO_LOGGING_LEVEL=info
